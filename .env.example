# Keitaro
KEITARO_ADMIN_URL=https://tlgk.host/admin
KEITARO_API_KEY=put-your-api-key-here

# Настройки создаваемых кампаний
CAMPAIGN_PREFIX=test_pogodina_
KT_DOMAIN_ID=1813
KT_GROUP_ID=10332
KT_TRAFFIC_SOURCE_ID=836
GOOGLE_URL=https://google.com

# База: по умолчанию SQLite, для Postgres:
# DATABASE_URL=postgresql+psycopg://keitaro:keitaro@localhost:5432/keitaro
DATABASE_URL=sqlite:///./editor.db

# Вход в обёртку (HTTP Basic). Задайте свой длинный пароль.
# Пустой AUTH_PASSWORD выключает вход — только для локальной разработки.
AUTH_USERNAME=admin
AUTH_PASSWORD=

STATS_DAYS=7
STATS_TIMEZONE=Europe/Moscow
